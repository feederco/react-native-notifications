{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./lib/src",
    "module": "node16",
    "moduleResolution": "node16",
    "customConditions": ["react-native", "react-native-legacy-deep-imports"],
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "types": [
      "lodash",
      "react"
    ]
  },
  "exclude": [
    "./lib/src/**/*.spec.ts",
    "./lib/src/**/*.test.ts"
  ]
}
